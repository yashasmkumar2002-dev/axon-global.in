        <tr><th scope="row">Slab size</th><td class="cmp-hero">3200 &times; 1600 mm (approx. 10.5 &times; 5.3 ft)</td><td>&mdash;</td></tr>
        <tr><th scope="row">Thickness</th><td class="cmp-hero">20 mm</td><td>&mdash;</td></tr>
        <tr><th scope="row">Weight</th><td class="cmp-hero">250 kg per slab &plusmn;2%</td><td>&mdash;</td></tr>
        <tr><th scope="row">Water absorption</th><td class="cmp-hero">&lt; 0.1 %</td><td>EN 14617-1</td></tr>
        <tr><th scope="row">Density</th><td class="cmp-hero">&gt; 2.30 g/cc</td><td>EN 14617-1</td></tr>
        <tr><th scope="row">Compressive strength</th><td class="cmp-hero">170 &ndash; 250 MPa</td><td>EN 14617-15</td></tr>
        <tr><th scope="row">Flexural strength</th><td class="cmp-hero">27 &ndash; 60 MPa</td><td>EN 14617-2</td></tr>
        <tr><th scope="row">Chemical resistance</th><td class="cmp-hero">Class C4</td><td>EN 14617-10</td></tr>
        <tr><th scope="row">Fire performance</th><td class="cmp-hero">B1 &mdash; low flammability</td><td>DIN 4102</td></tr>
        <tr><th scope="row">Slip resistance</th><td class="cmp-hero">R9</td><td>DIN 51130</td></tr>
        <tr><th scope="row">Shock resistance</th><td class="cmp-hero">No scaling</td><td>ASTM C848</td></tr>
        <tr><th scope="row">Glossiness</th><td class="cmp-hero">&gt; 55 % reflection</td><td>&mdash;</td></tr>
        <tr><th scope="row">Thermal expansion</th><td class="cmp-hero">&lt; 30 &times;10&#8315;&#8310; /&deg;C</td><td>EN 14617-11</td></tr>
