<!-- ── MATERIAL COMPARISON ───────────────────── -->
<section style="padding-top:120px;padding-bottom:100px;background:var(--bg);border-top:1px solid rgba(255,255,255,0.05);">
  <div class="section-eyebrow reveal">How It Compares</div>
  <div class="section-title reveal">Engineered quartz<br><em>vs natural</em><br>stone.</div>

  <div class="cmp-wrap reveal">
    <table class="cmp">
      <thead>
        <tr>
          <th></th>
          <th class="cmp-hero">Alito Quartz</th>
          <th>Granite</th>
          <th>Marble</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Material</th>
          <td class="cmp-hero">Engineered — approx. 93% natural quartz bound with resin</td>
          <td>Natural quarried stone</td>
          <td>Natural quarried stone</td>
        </tr>
        <tr>
          <th scope="row">Porosity</th>
          <td class="cmp-hero">Non-porous</td>
          <td>Porous</td>
          <td>Porous</td>
        </tr>
        <tr>
          <th scope="row">Sealing</th>
          <td class="cmp-hero">Never required</td>
          <td>Reseal periodically</td>
          <td>Reseal periodically</td>
        </tr>
        <tr>
          <th scope="row">Stain resistance</th>
          <td class="cmp-hero">High — non-porous surface resists oil, wine and turmeric</td>
          <td>Moderate — depends on seal condition</td>
          <td>Low — acids such as lemon and vinegar etch the surface</td>
        </tr>
        <tr>
          <th scope="row">Scratch resistance</th>
          <td class="cmp-hero">High — Mohs 7</td>
          <td>High — Mohs 6&ndash;7</td>
          <td>Low — Mohs 3&ndash;5</td>
        </tr>
        <tr>
          <th scope="row">Heat resistance</th>
          <td class="cmp-hero">Moderate — always use a trivet; the resin binder can discolour under direct heat</td>
          <td>High — the best of the three for hot cookware</td>
          <td>Moderate</td>
        </tr>
        <tr>
          <th scope="row">Antimicrobial</th>
          <td class="cmp-hero">Ultra Fresh&reg; built in — permanent, will not wash off</td>
          <td>Not inherent</td>
          <td>Not inherent</td>
        </tr>
        <tr>
          <th scope="row">Colour consistency</th>
          <td class="cmp-hero">Repeatable — slabs match, so large runs stay uniform</td>
          <td>Varies slab to slab</td>
          <td>Varies slab to slab</td>
        </tr>
        <tr>
          <th scope="row">Slab size</th>
          <td class="cmp-hero">1600 &times; 3200 mm, 20 mm thick</td>
          <td>Varies by block</td>
          <td>Varies by block</td>
        </tr>
        <tr>
          <th scope="row">Maintenance</th>
          <td class="cmp-hero">Soap and water</td>
          <td>Sealing plus pH-neutral cleaner</td>
          <td>Specialist care</td>
        </tr>
        <tr>
          <th scope="row">Warranty</th>
          <td class="cmp-hero">10-year manufacturer warranty</td>
          <td>Supplier dependent</td>
          <td>Supplier dependent</td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="cmp-scrollhint">&larr; Swipe to compare &rarr;</div>

  <p class="cmp-note reveal">Granite outperforms quartz on direct heat, so a trivet is still the right habit on any quartz worktop. Where quartz wins is consistency, hygiene and upkeep &mdash; no sealing, no etching, and slab-to-slab colour you can specify with confidence across a large project.</p>

  <div style="margin-top:40px;" class="reveal">
    <a href="https://wa.me/919449407945" class="btn-primary" target="_blank">Talk To Our Team</a>
    <a href="Alito-Quartz-Catalogue-2026.pdf" download class="btn-outline">&darr; Download E-Catalogue</a>
  </div>
</section>

<section id="contact">
  <div class="contact-orb"></div>
  <div class="contact-headline reveal">
    LET'S BUILD<br>
    <span class="ghost">SOMETHING</span>
    TOGETHER
  </div>
  <div class="contact-cards reveal">
    <div class="contact-card">
      <div class="contact-card-label">WhatsApp</div>
      <div class="contact-card-val">+91 94494 07945</div>
    </div>
    <div class="contact-card">
      <div class="contact-card-label">Email</div>
      <div class="contact-card-val">axonglobalpvt@gmail.com</div>
    </div>
    <div class="contact-card">
      <div class="contact-card-label">Location</div>
      <div class="contact-card-val">Jigani, Bangalore, Karnataka</div>
    </div>
    <div class="contact-card">
      <div class="contact-card-label">Working Hours</div>
      <div class="contact-card-val">Mon – Sat, 9am – 7pm</div>
    </div>
  </div>
  <div class="contact-btns reveal">
    <a href="https://wa.me/919449407945" class="btn-primary" target="_blank" data-cta="whatsapp">WhatsApp Now</a>
    <a href="tel:+919449407945" class="btn-outline" data-cta="call">Call Us</a>
  </div>

  <!-- ── ENQUIRY FORM ──────────────────────────────────────────────
       Works today with no backend: it composes a WhatsApp message.
       To capture leads properly (and track ad conversions), set
       FORM_ENDPOINT below to a Formspree / Google Form / your own URL. -->
  <div class="enq reveal">
    <div class="enq-head">
      <div class="enq-title">Request a quote</div>
      <div class="enq-sub">Tell us the project and we'll come back with slab availability and pricing.</div>
    </div>
    <form id="enqForm" novalidate>
      <div class="enq-row">
        <label class="enq-field">
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required>
        </label>
        <label class="enq-field">
          <span>Phone / WhatsApp</span>
          <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required>
        </label>
      </div>
      <div class="enq-row">
        <label class="enq-field">
          <span>City</span>
          <input type="text" name="city" autocomplete="address-level2">
        </label>
        <label class="enq-field">
          <span>I am a</span>
          <select name="role">
            <option value="">Select</option>
            <option>Architect</option>
            <option>Interior designer</option>
            <option>Builder / contractor</option>
            <option>Homeowner</option>
            <option>Fabricator / dealer</option>
          </select>
        </label>
      </div>
      <label class="enq-field">
        <span>What do you need?</span>
        <textarea name="detail" rows="3" placeholder="e.g. 3 slabs Calacatta Gold for a kitchen in Whitefield, needed by March"></textarea>
      </label>
      <div class="enq-actions">
        <button type="submit" class="btn-primary" id="enqBtn">Send Enquiry</button>
        <span class="enq-note" id="enqNote">Opens WhatsApp with your details filled in.</span>
      </div>
    </form>
  </div>
</section>

<!-- ── FOOTER ─────────────────────────────────── -->
