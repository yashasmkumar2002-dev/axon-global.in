    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </div>
</footer>

<!-- ── JAVASCRIPT ─────────────────────────────── -->
<script>
// ── Navbar scroll
window.addEventListener('scroll', () => {
  document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 60);
});

// ── Product tab switcher
function switchProduct(index) {
  document.querySelectorAll('.product-tab').forEach((t, i) => {
    t.classList.toggle('active', i === index);
  });
  document.querySelectorAll('.product-panel').forEach((p, i) => {
    p.classList.toggle('active', i === index);
  });
}

// ── Scroll reveal
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
      observer.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));


// ── Enquiry form
// Set this to a Formspree / your-own endpoint to capture leads server-side.
// Left empty, the form falls back to composing a WhatsApp message, which
// means it still works on day one with no backend.
const FORM_ENDPOINT = '';
const WA_NUMBER = '919449407945';

const enqForm = document.getElementById('enqForm');
if (enqForm) {
  enqForm.addEventListener('submit', async ev => {
    ev.preventDefault();
    const note = document.getElementById('enqNote');
    const btn  = document.getElementById('enqBtn');
    const d = Object.fromEntries(new FormData(enqForm).entries());

    let bad = false;
    enqForm.querySelectorAll('[required]').forEach(i => {
      const wrap = i.closest('.enq-field');
      const empty = !i.value.trim();
      wrap.classList.toggle('invalid', empty);
      if (empty) bad = true;
    });
    if (bad) {
      note.textContent = 'Please add your name and phone number.';
      note.className = 'enq-note err';
      return;
    }

    // fire an analytics event if a tag is installed
    if (typeof gtag === 'function') gtag('event', 'generate_lead', { method: FORM_ENDPOINT ? 'form' : 'whatsapp' });

    if (FORM_ENDPOINT) {
      btn.disabled = true;
      note.textContent = 'Sending...';
      note.className = 'enq-note';
      try {
        const r = await fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(enqForm)
        });
        if (!r.ok) throw new Error(r.status);
        enqForm.reset();
        note.textContent = 'Thanks - we will get back to you shortly.';
        note.className = 'enq-note ok';
      } catch (err) {
        note.textContent = 'Could not send. Please WhatsApp us on +91 94494 07945.';
        note.className = 'enq-note err';
      } finally {
        btn.disabled = false;
      }
      return;
    }

    const msg =
      'New enquiry from the website%0A%0A' +
      'Name: ' + encodeURIComponent(d.name || '-') + '%0A' +
      'Phone: ' + encodeURIComponent(d.phone || '-') + '%0A' +
      'City: ' + encodeURIComponent(d.city || '-') + '%0A' +
      'Role: ' + encodeURIComponent(d.role || '-') + '%0A' +
      'Requirement: ' + encodeURIComponent(d.detail || '-');
    window.open('https://wa.me/' + WA_NUMBER + '?text=' + msg, '_blank');
    note.textContent = 'Opening WhatsApp...';
    note.className = 'enq-note ok';
  });
}

// ── Track the WhatsApp / call buttons as conversions too
document.querySelectorAll('[data-cta]').forEach(el => {
  el.addEventListener('click', () => {
    if (typeof gtag === 'function') gtag('event', 'contact_click', { method: el.dataset.cta });
  });
});

// ── Parallax hero text on mouse
const heroCenter = document.querySelector('.hero-center');
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
let parallaxQueued = false;
if (heroCenter && !reduceMotion) {
  document.addEventListener('mousemove', e => {
    if (parallaxQueued) return;          // throttle to one update per frame
    parallaxQueued = true;
    requestAnimationFrame(() => {
      const dx = (e.clientX / window.innerWidth  - 0.5) * 14;
      const dy = (e.clientY / window.innerHeight - 0.5) * 8;
      heroCenter.style.transform = `translate(${dx}px, ${dy}px)`;
      parallaxQueued = false;
    });
  }, { passive: true });
}
</script>
</body>
</html>
