<!-- ── JAVASCRIPT ─────────────────────────────── -->
<script>
// ── Navbar scroll
window.addEventListener('scroll', () => {
  document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 60);
});

// ── Product tab switcher
function switchProduct(index) {
  document.querySelectorAll('.product-tab').forEach((t, i) => {
    t.classList.toggle('active', i === index);
  });
  document.querySelectorAll('.product-panel').forEach((p, i) => {
    p.classList.toggle('active', i === index);
  });
}

// ── Scroll reveal
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
      observer.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });

document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// ── Parallax hero text on mouse
const heroCenter = document.querySelector('.hero-center');
document.addEventListener('mousemove', e => {
  if (!heroCenter) return;
  const dx = (e.clientX / window.innerWidth  - 0.5) * 14;
  const dy = (e.clientY / window.innerHeight - 0.5) * 8;
  heroCenter.style.transform = `translate(${dx}px, ${dy}px)`;
});
</script>
</body>
