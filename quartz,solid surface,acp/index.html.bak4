<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Axon Global – Alito Quartz | Premium Engineered Surfaces | Bangalore</title>
<meta name="description" content="Axon Global — Premium Alito Quartz dealer in Bangalore. Engineered quartz for kitchens, bathrooms & luxury interiors. South India delivery.">
<style>
/* ── RESET & BASE ──────────────────────────────── */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg:       #060608;
  --bg2:      #0c0d10;
  --white:    #ffffff;
  --text:     #ffffff;
  --t80:      rgba(255,255,255,0.80);
  --t60:      rgba(255,255,255,0.60);
  --t40:      rgba(255,255,255,0.40);
  --t20:      rgba(255,255,255,0.20);
  --t10:      rgba(255,255,255,0.10);
  --t05:      rgba(255,255,255,0.05);
  --w80:      rgba(255,255,255,0.80);
  --w60:      rgba(255,255,255,0.60);
  --w40:      rgba(255,255,255,0.40);
  --w20:      rgba(255,255,255,0.20);
  --w10:      rgba(255,255,255,0.10);
  --w05:      rgba(255,255,255,0.05);
  --gold:     #c8b89a;
  --cool:     #8a9aa5;
  --border:   rgba(255,255,255,0.07);
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  background: var(--bg);
  color: var(--white);
  overflow-x: hidden;
  cursor: auto;
}

/* ── NOISE OVERLAY ─────────────────────────────── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1000;
  opacity: 0.4;
}

/* ── NAVBAR ────────────────────────────────────── */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 22px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid transparent;
  transition: border-color 0.4s, background 0.4s;
}
nav.scrolled {
  border-bottom-color: var(--border);
  background: rgba(6,6,8,0.85);
  backdrop-filter: blur(20px);
}
.nav-logo {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--w80);
}
.nav-logo span { color: var(--gold); }
.nav-links {
  display: flex;
  align-items: center;
  gap: 10px;
  list-style: none;
}
.nav-links a {
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--w40);
  text-decoration: none;
  transition: color 0.3s;
}
.nav-links a:hover { color: var(--white); }
.nav-divider {
  width: 24px; height: 1px;
  background: var(--w20);
}
.nav-wa {
  font-size: 10px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--bg);
  background: var(--w80);
  padding: 9px 20px;
  border-radius: 1px;
  text-decoration: none;
  font-weight: 600;
  transition: background 0.3s;
}
.nav-wa:hover { background: var(--white); }

/* ── HERO ──────────────────────────────────────── */
#hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background-image: url('hero-bg.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

/* Animated glowing orbs */
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  animation: orbFloat 8s ease-in-out infinite;
  pointer-events: none;
}
.orb-1 {
  width: 600px; height: 500px;
  background: radial-gradient(ellipse, rgba(200,184,154,0.18), transparent 70%);
  top: -100px; left: -150px;
  animation-delay: 0s;
}
.orb-2 {
  width: 500px; height: 500px;
  background: radial-gradient(ellipse, rgba(138,154,165,0.14), transparent 70%);
  top: 100px; right: -100px;
  animation-delay: -3s;
}
.orb-3 {
  width: 400px; height: 350px;
  background: radial-gradient(ellipse, rgba(160,140,120,0.12), transparent 70%);
  bottom: 0; left: 30%;
  animation-delay: -5s;
}
@keyframes orbFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33%       { transform: translate(30px, -40px) scale(1.05); }
  66%       { transform: translate(-20px, 20px) scale(0.95); }
}

/* Mouse-follow glow — disabled */

/* Left micro menu */
.hero-left {
  position: absolute;
  left: 40px;
  bottom: 60px;
  z-index: 3;
}
.hero-left-label {
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--w50, rgba(255,255,255,0.5));
  margin-bottom: 16px;
}
.hero-left-items {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.hero-left-items li a {
  font-size: 12px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: color 0.3s;
}
.hero-left-items li a::before {
  content: '→';
  color: var(--w20);
  transition: color 0.3s, transform 0.3s;
}
.hero-left-items li a:hover { color: var(--w80); }
.hero-left-items li a:hover::before { color: var(--gold); transform: translateX(4px); }
.hero-left-wa {
  display: inline-block;
  margin-top: 20px;
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  border: 1px solid rgba(255,255,255,0.20);
  padding: 9px 16px;
  text-decoration: none;
  transition: color 0.3s, border-color 0.3s;
}
.hero-left-wa:hover { color: var(--white); border-color: var(--w40); }

/* Hero center */
.hero-center {
  text-align: center;
  position: relative;
  z-index: 3;
  user-select: none;
}
.hero-eyebrow {
  font-size: 9px;
  letter-spacing: 6px;
  text-transform: uppercase;
  color: var(--w20);
  margin-bottom: 28px;
  opacity: 0;
  animation: fadeUp 1s 0.3s forwards;
}
.hero-line {
  font-size: clamp(52px, 9vw, 88px);
  font-weight: 800;
  letter-spacing: -3px;
  line-height: 0.92;
  text-transform: uppercase;
  display: block;
  opacity: 0;
  transform: translateY(30px);
  animation: fadeUp 0.9s forwards;
}
.hero-line-1 { color: var(--white); animation-delay: 0.5s; }
.hero-line-2 {
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,255,255,0.2);
  animation-delay: 0.7s;
}
.hero-line-3 { color: var(--w80); animation-delay: 0.9s; }

.hero-sub2 {
  margin-top: 10px;
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--w40);
  text-shadow: 0 2px 12px rgba(0,0,0,0.85);
}
.hero-sub {
  margin-top: 32px;
  font-size: 10px;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--w60);
  text-shadow: 0 2px 12px rgba(0,0,0,0.85);
  opacity: 0;
  animation: fadeUp 1s 1.1s forwards;
}
@keyframes fadeUp {
  to { opacity: 1; transform: translateY(0); }
}

/* Bottom right */
.hero-right-info {
  position: absolute;
  right: 40px;
  bottom: 60px;
  text-align: right;
  z-index: 3;
}
.hero-right-info p {
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  margin-bottom: 6px;
}
.hero-right-info strong {
  font-size: 15px;
  color: rgba(255,255,255,0.80);
  letter-spacing: 1px;
}

/* Scroll indicator */
.scroll-hint {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  z-index: 2;
  opacity: 0;
  animation: fadeUp 1s 1.5s forwards;
}
.scroll-hint span {
  font-size: 9px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.50);
}
.scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.50), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse {
  0%, 100% { opacity: 0.3; transform: scaleY(1); }
  50%       { opacity: 1; transform: scaleY(1.1); }
}

/* ── SECTION COMMON ────────────────────────────── */
section { padding: 120px 40px; position: relative; }

.section-eyebrow {
  font-size: 8px;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.section-eyebrow::before {
  content: '';
  display: block;
  width: 24px; height: 1px;
  background: var(--gold);
  opacity: 0.5;
}
.section-title {
  font-size: clamp(32px, 5vw, 50px);
  font-weight: 700;
  letter-spacing: -1.5px;
  line-height: 1.05;
  color: var(--white);
  margin-bottom: 60px;
}
.section-title em {
  font-style: normal;
  color: var(--w20);
  -webkit-text-stroke: 1px rgba(255,255,255,0.15);
}

/* Reveal on scroll */
.reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── PRODUCTS SECTION ──────────────────────────── */
#products {
  background: var(--bg2);
}
.products-layout {
  display: flex;
  gap: 0;
  border: 1px solid var(--border);
  border-radius: 4px;
  overflow: hidden;
  min-height: 580px;
}

/* Product left tabs */
.product-tabs {
  width: 240px;
  border-right: 1px solid var(--border);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}
.product-tab {
  padding: 28px 24px;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  transition: background 0.3s;
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.product-tab::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 2px;
  background: var(--gold);
  transform: scaleY(0);
  transition: transform 0.35s ease;
}
.product-tab.active::before,
.product-tab:hover::before { transform: scaleY(1); }
.product-tab.active { background: var(--w05); }
.tab-swatch {
  width: 20px;
  height: 2px;
  border-radius: 1px;
  margin-bottom: 14px;
  opacity: 0.45;
  transition: width 0.3s ease, opacity 0.3s;
}
.product-tab.active .tab-swatch,
.product-tab:hover .tab-swatch { width: 32px; opacity: 1; }
.tab-num {
  font-size: 8px;
  letter-spacing: 3px;
  color: var(--w20);
  margin-bottom: 8px;
}
.tab-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--w40);
  transition: color 0.3s;
  letter-spacing: 0.5px;
  line-height: 1.4;
}
.product-tab.active .tab-name,
.product-tab:hover .tab-name { color: var(--w80); }
.tab-hint {
  font-size: 9px;
  letter-spacing: 2px;
  color: var(--w20);
  margin-top: 5px;
  text-transform: uppercase;
  transition: color 0.3s;
}
.product-tab.active .tab-hint { color: var(--gold); }

/* Product display */
.product-display {
  flex: 1;
  position: relative;
  overflow: hidden;
}
.product-panel {
  display: none;
  height: 100%;
  flex-direction: column;
  justify-content: flex-end;
  padding: 44px;
  position: relative;
  min-height: 580px;
}
.product-panel.active { display: flex; }

/* Slab background textures */
.panel-bg {
  position: absolute;
  inset: 0;
  transition: opacity 0.5s;
}
.panel-bg-quartz {
  background:
    radial-gradient(ellipse at 72% 22%, rgba(200,184,154,0.28) 0%, transparent 55%),
    radial-gradient(ellipse at 20% 80%, rgba(160,150,135,0.12) 0%, transparent 45%),
    linear-gradient(135deg, #0c0b09 0%, #141210 50%, #0a0908 100%);
}

.panel-bg-solid {
  background:
    radial-gradient(ellipse at 72% 22%, rgba(190,155,140,0.25) 0%, transparent 55%),
    radial-gradient(ellipse at 20% 80%, rgba(130,100,90,0.12) 0%, transparent 45%),
    linear-gradient(135deg, #0d0808 0%, #130d0c 50%, #0a0808 100%);
}
.panel-bg-boilo {
  background:
    radial-gradient(ellipse at 72% 22%, rgba(140,180,140,0.22) 0%, transparent 55%),
    radial-gradient(ellipse at 20% 80%, rgba(90,130,90,0.12) 0%, transparent 45%),
    linear-gradient(135deg, #08100a 0%, #0c150e 50%, #080f09 100%);
}

/* Dot grid overlay */
.panel-dot-grid {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle, rgba(255,255,255,0.035) 1px, transparent 1px);
  background-size: 28px 28px;
  z-index: 1;
  pointer-events: none;
}

/* Ghost watermark text */
.panel-ghost {
  position: absolute;
  bottom: 100px;
  right: -20px;
  font-size: clamp(90px, 13vw, 160px);
  font-weight: 900;
  letter-spacing: -6px;
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,255,255,0.045);
  white-space: nowrap;
  pointer-events: none;
  z-index: 1;
  user-select: none;
  text-transform: uppercase;
  line-height: 1;
}

/* Slab glow */
.slab-glow {
  position: absolute;
  top: 0;
  right: 0;
  width: 480px;
  height: 400px;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: 1;
  opacity: 0.5;
}
.glow-quartz { background: radial-gradient(ellipse, rgba(200,180,140,0.4), transparent 70%); }

.glow-solid  { background: radial-gradient(ellipse, rgba(200,160,140,0.35), transparent 70%); }
.glow-boilo  { background: radial-gradient(ellipse, rgba(120,180,120,0.3), transparent 70%); }

.slab-texture-boilo {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 30%, #f8f8f8 55%, #e0e0e0 80%, #ececec 100%);
}

/* 3D slab card floating in panel */
.slab-3d {
  position: absolute;
  top: 36px;
  right: 36px;
  width: 360px;
  height: 248px;
  transform: perspective(900px) rotateY(-18deg) rotateX(10deg);
  transition: transform 0.6s ease;
  border-radius: 6px;
  overflow: hidden;
  box-shadow:
    40px 40px 80px rgba(0,0,0,0.75),
    0 0 0 1px rgba(255,255,255,0.06),
    -8px -8px 24px rgba(255,255,255,0.04);
  z-index: 3;
}
.slab-3d:hover {
  transform: perspective(900px) rotateY(-8deg) rotateX(4deg) translateY(-8px);
}
.slab-texture-quartz {
  width: 100%; height: 100%;
  background:
    repeating-linear-gradient(20deg, rgba(160,145,125,0.25) 0, rgba(160,145,125,0.25) 1px, transparent 1px, transparent 30px),
    repeating-linear-gradient(80deg, rgba(180,165,145,0.15) 0, rgba(180,165,145,0.15) 1px, transparent 1px, transparent 50px),
    linear-gradient(135deg, #e8e2d8 0%, #d4cbbe 25%, #ece8e0 50%, #c8bfb0 75%, #ddd8ce 100%);
}

.slab-texture-solid {
  width: 100%; height: 100%;
  background:
    linear-gradient(135deg, #f0ece8 0%, #e8e0d8 30%, #f4f0ec 55%, #e0d8d0 80%, #ece4dc 100%);
}
.slab-glare {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.55) 0%, transparent 42%, rgba(0,0,0,0.18) 100%);
}
@keyframes slabShimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
.slab-shimmer {
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,0.1) 50%, transparent 62%);
  background-size: 200% 100%;
  animation: slabShimmer 4s ease-in-out infinite;
}

/* Product info */
.product-info-grid {
  position: relative;
  z-index: 4;
}
.product-info-num {
  font-size: 8px;
  letter-spacing: 3px;
  color: var(--w20);
  margin-bottom: 10px;
}
.product-info-name {
  font-size: clamp(26px, 3.5vw, 38px);
  font-weight: 800;
  letter-spacing: -1.5px;
  color: var(--white);
  margin-bottom: 14px;
  line-height: 1.1;
}
.product-info-desc {
  font-size: 12px;
  line-height: 1.9;
  color: var(--w40);
  max-width: 420px;
  margin-bottom: 20px;
}
.product-specs-divider {
  width: 40px;
  height: 1px;
  background: var(--gold);
  opacity: 0.4;
  margin-bottom: 20px;
}
.product-specs {
  display: flex;
  gap: 32px;
}
.spec-item {}
.spec-val {
  font-size: 20px;
  font-weight: 800;
  color: var(--gold);
  margin-bottom: 4px;
  letter-spacing: -0.5px;
}
.spec-key {
  font-size: 8px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--w20);
}

/* ── WHY US ────────────────────────────────────── */
#why {
  background: var(--bg);
}
.why-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
}
.why-card {
  background: var(--bg);
  padding: 40px 30px;
  transition: background 0.3s;
}
.why-card:hover { background: var(--w05); }
.why-icon-wrap {
  width: 44px; height: 44px;
  border: 1px solid var(--border);
  border-radius: 2px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20px;
  font-size: 18px;
  transition: border-color 0.3s;
}
.why-card:hover .why-icon-wrap { border-color: var(--gold); }
.why-card-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--w80);
  margin-bottom: 10px;
  letter-spacing: -0.3px;
}
.why-card-text {
  font-size: 12px;
  line-height: 1.8;
  color: var(--w40);
}

/* ── GALLERY / MATERIAL SHOWCASE ───────────────── */
#gallery {
  background: var(--bg2);
  overflow: hidden;
}
.gallery-strip {
  display: flex;
  gap: 16px;
  margin-top: 0;
  animation: stripScroll 20s linear infinite;
  width: max-content;
}
.gallery-strip:hover { animation-play-state: paused; }
@keyframes stripScroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.gallery-chip {
  width: 200px;
  height: 130px;
  border-radius: 3px;
  overflow: hidden;
  flex-shrink: 0;
  border: 1px solid rgba(28,26,23,0.10);
  position: relative;
}
.gallery-chip-inner {
  width: 100%; height: 100%;
  display: flex;
  align-items: flex-end;
  padding: 12px;
  position: relative;
}
.gc-quartz-1 { background: linear-gradient(135deg, #e0d8ce, #c8bfb0, #ece8e0); }
.gc-quartz-2 { background: linear-gradient(135deg, #1a1a1a, #2d2d2d, #1a1a1a); }
.gc-quartz-3 { background: linear-gradient(135deg, #c8c0b8, #b0a898, #d0c8c0); }



.gc-solid-1  { background: linear-gradient(135deg, #f0ece8, #e4ddd8, #f4f0ec); }
.gc-solid-2  { background: linear-gradient(135deg, #1e2830, #283440, #1e2830); }
.gc-solid-3  { background: linear-gradient(135deg, #e8dfd8, #d8d0c8, #f0e8e0); }
.chip-label-overlay {
  font-size: 8px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  position: relative;
  z-index: 1;
}
.gallery-chip::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 50%);
}

/* ── CONTACT ───────────────────────────────────── */
#contact {
  background: var(--bg);
  text-align: center;
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.contact-orb {
  position: absolute;
  width: 700px; height: 500px;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(200,184,154,0.07), transparent 65%);
  filter: blur(60px);
  top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  pointer-events: none;
}
.contact-headline {
  font-size: clamp(40px, 8vw, 80px);
  font-weight: 800;
  letter-spacing: -3px;
  line-height: 0.95;
  margin-bottom: 60px;
  position: relative;
  z-index: 1;
}
.contact-headline .ghost {
  display: block;
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,255,255,0.1);
}
.contact-cards {
  display: flex;
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  margin-bottom: 40px;
  position: relative;
  z-index: 1;
}
.contact-card {
  background: var(--bg);
  padding: 28px 44px;
  text-align: center;
  transition: background 0.3s;
}
.contact-card:hover { background: var(--w05); }
.contact-card-label {
  font-size: 7px;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--w20);
  margin-bottom: 10px;
}
.contact-card-val {
  font-size: 14px;
  font-weight: 500;
  color: var(--w60);
}
.contact-btns {
  display: flex;
  gap: 12px;
  justify-content: center;
  position: relative;
  z-index: 1;
}
.btn-primary {
  display: inline-block;
  background: rgba(255,255,255,0.88);
  color: var(--bg);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  padding: 14px 32px;
  text-decoration: none;
  transition: background 0.3s, transform 0.2s;
}
.btn-primary:hover { background: var(--white); transform: translateY(-2px); }
.btn-outline {
  display: inline-block;
  border: 1px solid var(--border);
  color: var(--w40);
  font-size: 9px;
  letter-spacing: 3px;
  text-transform: uppercase;
  padding: 14px 32px;
  text-decoration: none;
  transition: border-color 0.3s, color 0.3s, transform 0.2s;
}
.btn-outline:hover { border-color: var(--w40); color: var(--w80); transform: translateY(-2px); }

.btn-outline-light {
  display: inline-block;
  border: 1px solid var(--border);
  color: var(--w40);
  font-size: 9px;
  letter-spacing: 3px;
  text-transform: uppercase;
  padding: 10px 22px;
  text-decoration: none;
  transition: border-color 0.3s, color 0.3s, transform 0.2s;
}
.btn-outline-light:hover { border-color: var(--w60); color: var(--w80); transform: translateY(-2px); }


/* ── COMPARISON TABLE ──────────────────────────── */
.cmp-wrap { margin-top: 56px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.cmp { width: 100%; min-width: 720px; border-collapse: collapse; }
.cmp th, .cmp td {
  padding: 16px 18px;
  text-align: left;
  font-size: 12px;
  line-height: 1.6;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
}
.cmp thead th {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--w40);
  border-bottom: 1px solid var(--w20);
  white-space: nowrap;
}
.cmp thead th.cmp-hero { color: var(--gold); }
.cmp tbody th {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--w40);
  white-space: nowrap;
  width: 190px;
}
.cmp td { color: var(--w60); }
.cmp td.cmp-hero { color: var(--w80); background: rgba(200,184,154,0.045); }
.cmp tbody tr:hover td { background: rgba(255,255,255,0.02); }
.cmp tbody tr:hover td.cmp-hero { background: rgba(200,184,154,0.08); }
.cmp-note {
  margin-top: 18px;
  font-size: 11px;
  line-height: 1.7;
  color: var(--w40);
  max-width: 720px;
}
.cmp-scrollhint {
  display: none;
  font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
  color: var(--w20); margin-top: 10px;
}
@media (max-width: 860px) { .cmp-scrollhint { display: block; } }

/* ── FOOTER ────────────────────────────────────── */
footer {
  background: #0c0b09;
  border-top: 1px solid rgba(255,255,255,0.07);
  padding: 30px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}
.footer-logo {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--w40);
}
.footer-logo span { color: var(--gold); }
.footer-copy {
  font-size: 10px;
  color: var(--w20);
  letter-spacing: 1px;
}
.footer-links {
  display: flex;
  gap: 24px;
}
.footer-links a {
  font-size: 9px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--w20);
  text-decoration: none;
  transition: color 0.3s;
}
.footer-links a:hover { color: var(--w60); }

/* ── MOBILE ────────────────────────────────────── */
@media (max-width: 768px) {
  nav { padding: 18px 20px; }
  .nav-links { display: none; }
  .hero-left { display: none; }
  .hero-right-info { right: 20px; }
  section { padding: 80px 20px; }
  .products-layout { flex-direction: column; }
  .product-tabs { width: 100%; display: flex; border-right: none; border-bottom: 1px solid var(--border); overflow-x: auto; }
  .product-tab { flex-shrink: 0; }
  .slab-3d { width: 200px; height: 136px; right: 16px; top: 16px; }
  .panel-ghost { font-size: 70px; bottom: 80px; }
  .why-grid { grid-template-columns: 1fr; }
  .contact-cards { flex-direction: column; }
  footer { flex-direction: column; text-align: center; }
  body { cursor: auto; }
}

/* ── ENHANCED ANIMATIONS ─────────────────── */
@keyframes slideInUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-30px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes slideInRight {
  from { opacity: 0; transform: translateX(30px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
}

/* stagger siblings inside grids so cards cascade in */
.why-grid .reveal:nth-child(1),
.contact-cards .reveal:nth-child(1) { transition-delay: 0.00s; }
.why-grid .reveal:nth-child(2) { transition-delay: 0.08s; }
.why-grid .reveal:nth-child(3) { transition-delay: 0.16s; }
.why-grid .reveal:nth-child(4) { transition-delay: 0.24s; }
.why-grid .reveal:nth-child(5) { transition-delay: 0.32s; }
.why-grid .reveal:nth-child(6) { transition-delay: 0.40s; }

/* Product card hover enhancement */
.product-tab:hover {
  transform: translateX(4px);
  transition: transform 0.3s ease;
}

.why-card:hover {
  transform: translateY(-4px);
  transition: transform 0.3s ease;
  box-shadow: 0 20px 40px rgba(0,0,0,0.3);
}

/* Button shine — angled glint sweep */
.btn-primary, .btn-outline, .btn-outline-light, .btn-quote {
  position: relative;
  overflow: hidden;
}

.btn-primary::after, .btn-outline::after,
.btn-outline-light::after, .btn-quote::after {
  content: '';
  position: absolute;
  top: -10%;
  left: -150%;
  width: 55%;
  height: 120%;
  transform: skewX(-22deg);
  pointer-events: none;
  background: linear-gradient(100deg,
    transparent 0%,
    rgba(255,255,255,0.38) 50%,
    transparent 100%);
  transition: left 0.55s cubic-bezier(0.25,0.8,0.3,1);
}

/* btn-primary is near-white, so it needs a dark glint to be visible */
.btn-primary::after {
  background: linear-gradient(100deg,
    transparent 0%,
    rgba(0,0,0,0.16) 50%,
    transparent 100%);
}

/* gold CTA gets a gold-tinted glint */
.btn-quote::after {
  background: linear-gradient(100deg,
    transparent 0%,
    rgba(200,184,154,0.45) 50%,
    transparent 100%);
}

.btn-primary:hover::after, .btn-outline:hover::after,
.btn-outline-light:hover::after, .btn-quote:hover::after {
  left: 165%;
}

@media (prefers-reduced-motion: reduce) {
  .btn-primary::after, .btn-outline::after,
  .btn-outline-light::after, .btn-quote::after { display: none; }
}

/* CTA Button Styles */
.btn-quote {
  display: inline-block;
  background: transparent;
  border: 1px solid var(--gold);
  color: var(--gold);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 10px 20px;
  text-decoration: none;
  transition: all 0.3s;
  margin-top: 12px;
  margin-right: 8px;
}

.btn-quote:hover {
  background: var(--gold);
  color: var(--bg);
  transform: translateY(-2px);
}

</style>
</head>
